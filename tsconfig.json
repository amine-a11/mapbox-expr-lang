{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Environment Settings
    // Library is built by tsup (esbuild); this config is used for
    // typechecking and editor tooling, not for emitting JS.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["ES2022"],
    "types": ["node"],
    // tsup's declaration-bundler step injects a `baseUrl` internally,
    // which TS 6.0 now errors on as deprecated (removed in TS 7.0).
    // We don't use baseUrl/paths ourselves, so this is safe to silence.
    "ignoreDeprecations": "6.0",

    // Other Outputs
    "noEmit": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "test", "tsup.config.ts", "eslint.config.js"]
}
